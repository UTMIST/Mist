FROM oven/bun:1-alpine AS web
WORKDIR /build/web
COPY web-interface/package.json web-interface/bun.lock ./
RUN bun install --frozen-lockfile
COPY web-interface/ ./
RUN bun run build && bunx tsc --noEmit

FROM golang:1.25-alpine AS backend
WORKDIR /build/src
COPY src/ ./
RUN CGO_ENABLED=0 go build -mod=readonly -o /mist .

FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
WORKDIR /app/src
COPY --from=backend /mist /usr/local/bin/mist
COPY --from=web /build/web/dist /app/web
COPY config/log.yaml /app/config/log.yaml
ENV MIST_WEB_DIR=/app/web
ENV MIST_EXECUTOR=local
RUN mkdir -p /app/logs && chown 65534:65534 /app/logs
USER 65534:65534
EXPOSE 3000
CMD ["mist"]
