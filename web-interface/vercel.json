{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck && npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|auth(?:/|$)|docs(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
