# Copy to a protected operator file; never commit the populated copy.
# Enable only after the portal and gateway have working HTTPS.
MIST_AUTH_MODE=misty
MIST_SITE_ORIGIN=https://compute.example.com
MISTY_GATEWAY_URL=https://gateway.example.com
# Must match the gateway's GATEWAY_ENV; use staging with a separate test database.
MISTY_ENVIRONMENT=production
# Operator-reviewed immutable Misty UUID -> existing compute user ID mappings.
# Required for existing accounts; new eligible members receive role user.
MISTY_ACCOUNT_LINKS={}
# Issued gw_ key with exactly auth:email and auth:status; server-side only.
MISTY_GATEWAY_API_KEY=
